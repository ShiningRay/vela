{
  "name": "vela",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vela Desktop — a Solid + TypeScript desktop platform, borrowing the architecture lessons of Citrine.",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @vela/app-demo dev",
    "dev:components": "pnpm --filter @vela/app-components dev",
    "dev:service": "pnpm --filter @vela/service-demo dev",
    "dev:desktop": "pnpm --filter @vela/app-desktop tauri dev",
    "build": "pnpm -r --if-present build",
    "build:service": "pnpm --filter @vela/service-demo build",
    "prepare:runtime": "node scripts/prepare-node-runtime.mjs",
    "build:desktop": "pnpm --filter @vela/app-desktop tauri build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tauri-apps/cli": "^2.12.4",
    "fake-indexeddb": "^6.2.7",
    "fflate": "^0.8.3",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.0.5"
  }
}
