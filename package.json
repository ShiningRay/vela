{
  "name": "vela",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vela Desktop — a Solid + TypeScript desktop platform, borrowing the architecture lessons of Citrine.",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @vela/app-demo dev",
    "dev:service": "pnpm --filter @vela/service-demo dev",
    "dev:desktop": "pnpm --filter @vela/app-desktop tauri dev",
    "build": "pnpm -r --if-present build",
    "build:service": "pnpm --filter @vela/service-demo build",
    "build:desktop": "pnpm --filter @vela/app-desktop tauri build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.0.5"
  }
}
